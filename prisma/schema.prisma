generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int           @id @default(autoincrement())
  name         String
  email        String        @unique
  password     String
  role         String        @default("user") // Varsayılan olarak herkes 'user' olacak
  projects     Project[]
  
  // --- Yeni Eklenen İlişkiler ---
  tasks        Task[]        // Kullanıcının oluşturduğu görevler
  activityLogs ActivityLog[] // Kullanıcının yaptığı aktiviteler

  // --- Workspace İlişkisi ---
  workspaceMembers WorkspaceMember[] // Kullanıcının dahil olduğu çalışma alanları
}

// --- YENİ: Çalışma Alanı (Workspace) Modeli ---
model Workspace {
  id         Int                @id @default(autoincrement())
  name       String
  password   String             // bcrypt ile hashlenmiş şifre
  inviteCode String             @unique // Benzersiz davet kodu (UUID)
  createdAt  DateTime           @default(now())
  members    WorkspaceMember[]  // Bu alana dahil üyeler
  projects   Project[]          // Bu alana ait projeler
}

// --- YENİ: Çalışma Alanı Üyelik Modeli ---
model WorkspaceMember {
  id          Int       @id @default(autoincrement())
  role        String    @default("MEMBER") // 'ADMIN' veya 'MEMBER'
  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId Int
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId]) // Bir kullanıcı aynı workspace'te 2 kez olamaz
}

model Project {
  id           Int           @id @default(autoincrement())
  name         String
  userId       Int
  user         User          @relation(fields: [userId], references: [id])
  tasks        Task[] 
  columns      Column[]
  
  // --- Workspace İlişkisi ---
  workspaceId  Int?
  workspace    Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // --- Yeni Eklenen İlişki ---
  activityLogs ActivityLog[] // Projeye ait son hareketler (Log kayıtları)
}

model Column {
  id        Int      @id @default(autoincrement())
  title     String   // "Yapılacaklar", "Devam Edenler" vb.
  order     Int      // Sütunların yan yana diziliş sırası
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]
}

model Task {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  
  // Detay Alanları
  dueDate     DateTime? // Son tarih (opsiyonel)
  color       String?   // Etiket rengi (opsiyonel)

  status      String    @default("todo") 
  projectId   Int
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  // Sürükle-Bırak için Eklenenler
  order       Int       @default(0)      // Görevin sütun içindeki dikey sırası
  columnId    Int?                       // Hangi sütuna ait olduğu
  column      Column?   @relation(fields: [columnId], references: [id], onDelete: Cascade)

  // --- Yeni Eklenen: Görevi Kimin Oluşturduğu ---
  userId      Int?      
  user        User?     @relation(fields: [userId], references: [id])
}

//  Projedeki Son Değişiklikler (Hareket Dökümü) Tablosu ---
model ActivityLog {
  id        Int      @id @default(autoincrement())
  action    String   // Örn: "Görev eklendi", "Görev silindi", "Renk değiştirildi"
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}